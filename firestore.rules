rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can read and write only their own units and progress.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public word library: anyone can read, only the admin can write.
    match /library/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'pixel9profold20240813@gmail.com'
                   && request.auth.token.email_verified == true;
    }
  }
}
